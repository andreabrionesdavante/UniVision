<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- CABECERA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textColor="#2F63FF"
                android:textSize="28sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UniVision"
                    android:textColor="#2F63FF"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Comparador"
                    android:textColor="#1F2437"
                    android:textSize="28sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- UNIVERSIDADES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="horizontal">

            <!-- UPM -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="230dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scaleType="centerCrop"
                        android:src="@drawable/uni2" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UPM"
                            android:textColor="#2F63FF"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Politécnica de Madrid"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Madrid"
                            android:textColor="#6B7280"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- UPV -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="230dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scaleType="centerCrop"
                        android:src="@drawable/uni1" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UPV"
                            android:textColor="#2F63FF"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Politécnica de València"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="València"
                            android:textColor="#6B7280"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- TABLA -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            app:cardCornerRadius="20dp">

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="1,2">

                <TableRow
                    android:background="#DCE8FF">

                    <TextView
                        android:padding="14dp"
                        android:text="De un vistazo"
                        android:textColor="#2F63FF"
                        android:textStyle="bold" />

                    <TextView
                        android:gravity="center"
                        android:padding="14dp"
                        android:text="UPM"
                        android:textColor="#2F63FF"
                        android:textStyle="bold" />

                    <TextView
                        android:gravity="center"
                        android:padding="14dp"
                        android:text="UPV"
                        android:textColor="#2F63FF"
                        android:textStyle="bold" />

                </TableRow>

                <TableRow>
                    <TextView
                        android:padding="14dp"
                        android:text="Ubicación" />

                    <TextView
                        android:gravity="center"
                        android:padding="14dp"
                        android:text="Madrid"
                        android:textStyle="bold" />

                    <TextView
                        android:gravity="center"
                        android:padding="14dp"
                        android:text="Valencia"
                        android:textStyle="bold" />
                </TableRow>

                <TableRow>
                    <TextView
                        android:padding="14dp"
                        android:text="Tipo" />

                    <TextView
                        android:gravity="center"
                        android:padding="14dp"
                        android:text="Pública"
                        android:textStyle="bold" />

                    <TextView
                        android:gravity="center"
                        android:padding="14dp"
                        android:text="Pública"
                        android:textStyle="bold" />
                </TableRow>

                <TableRow>
                    <TextView
                        android:padding="14dp"
                        android:text="Valoración" />

                    <TextView
                        android:gravity="center"
                        android:padding="14dp"
                        android:text="★ 4,5 / 5"
                        android:textStyle="bold" />

                    <TextView
                        android:gravity="center"
                        android:padding="14dp"
                        android:text="★ 4,6 / 5"
                        android:textStyle="bold" />
                </TableRow>

                <TableRow>
                    <TextView
                        android:padding="14dp"
                        android:text="N.º de grados" />

                    <TextView
                        android:gravity="center"
                        android:padding="14dp"
                        android:text="54"
                        android:textStyle="bold" />

                    <TextView
                        android:gravity="center"
                        android:padding="14dp"
                        android:text="42"
                        android:textStyle="bold" />
                </TableRow>

                <TableRow
                    android:background="#EEF3FB">

                    <TextView
                        android:padding="14dp"
                        android:text="Nota de corte media" />

                    <TextView
                        android:gravity="center"
                        android:padding="14dp"
                        android:text="10,72"
                        android:textColor="#2F63FF"
                        android:textStyle="bold" />

                    <TextView
                        android:gravity="center"
                        android:padding="14dp"
                        android:text="10,35"
                        android:textColor="#2F63FF"
                        android:textStyle="bold" />
                </TableRow>

            </TableLayout>

    </androidx.cardview.widget.CardView>

    <!-- AQUI PEGA EL MENU INFERIOR -->

<LinearLayout
android:layout_width="match_parent"
android:layout_height="80dp"
android:layout_marginTop="120dp"
android:background="#FFFFFF"
android:gravity="center"
android:orientation="horizontal"
android:weightSum="4">

<LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏠"
        android:textSize="20sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Inicio"/>
</LinearLayout>

<LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏛"
        android:textSize="20sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Universidades"
        android:textColor="#2F63FF"
        android:textStyle="bold"/>
</LinearLayout>

<LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎓"
        android:textSize="20sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Grados"/>
</LinearLayout>

<LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👤"
        android:textSize="20sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Perfil"/>
</LinearLayout>

</LinearLayout>

    </LinearLayout>

    </ScrollView>