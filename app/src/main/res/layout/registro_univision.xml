<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Título con flecha -->
            <TextView
                android:id="@+id/tvCrearCuenta"
                style="@style/TextoTitulosPantallas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:text="@string/registration_link"
                app:drawableStartCompat="@drawable/ic_flecha_antes"
                app:drawableTint="@color/titulos" />

            <!-- Nombre -->
            <TextView
                android:id="@+id/tvNombre"
                style="@style/TextoDescriptivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/nombre"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNombre"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/fondo_app"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/nombre_hint"
                    android:inputType="textPersonName"
                    android:paddingVertical="14dp"
                    android:textAppearance="@style/TextoCampos"
                    android:textColorHint="@color/texto_recuadro" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Apellidos -->
            <TextView
                android:id="@+id/tvApellidos"
                style="@style/TextoDescriptivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/apellidos"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilApellidos"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/fondo_app"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etApellidos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/apellidos_hint"
                    android:inputType="textPersonName"
                    android:paddingVertical="14dp"
                    android:textAppearance="@style/TextoCampos"
                    android:textColorHint="@color/texto_recuadro" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Correo electrónico -->
            <TextView
                android:id="@+id/tvCorreo"
                style="@style/TextoDescriptivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/email_label"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCorreo"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/fondo_app"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/email_hint"
                    android:inputType="textEmailAddress"
                    android:paddingVertical="14dp"
                    android:textAppearance="@style/TextoCampos"
                    android:textColorHint="@color/texto_recuadro" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Contraseña -->
            <TextView
                style="@style/TextoDescriptivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/field_label"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilContrasena"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/fondo_app"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/texto_recuadro"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/field_value"
                    android:inputType="textPassword"
                    android:paddingVertical="14dp"
                    android:textAppearance="@style/TextoCampos"
                    android:textColorHint="@color/texto_recuadro" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Confirmar contraseña -->
            <TextView
                style="@style/TextoDescriptivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/confirmar_contrasena"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConfrimarContra"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/fondo_app"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/texto_recuadro"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmarContra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/confirmar_contrasena"
                    android:inputType="textPassword"
                    android:paddingVertical="14dp"
                    android:textAppearance="@style/TextoCampos"
                    android:textColorHint="@color/texto_recuadro" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Selector de etapa -->
            <TextView
                style="@style/TextoDescriptivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/etapa"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgEtapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_contenedor_etapa"
                android:orientation="horizontal"
                android:padding="4dp">

                <RadioButton
                    android:id="@+id/rbFuturo"
                    style="@style/TextoSelectorEtapa"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_opcion_etapa"
                    android:button="@null"
                    android:checked="true"
                    android:drawableStart="@drawable/icono_check_etapa"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="@string/futuro_estudiante"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbEstudiante"
                    style="@style/TextoSelectorEtapa"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_opcion_etapa"
                    android:button="@null"
                    android:drawableStart="@drawable/icono_check_etapa"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="@string/estudiante_universitario" />
            </RadioGroup>

            <!-- Botón Registro -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistro"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/botones"
                android:text="@string/registro"
                android:textAllCaps="false"
                android:textAppearance="@style/TextoBotones"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_flecha_next"
                app:iconGravity="textEnd"
                app:iconPadding="8dp"
                app:iconTint="@color/white" />

            <!-- Pie de inicio de sesión -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextoAdicional"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cuenta_existente" />

                <TextView
                    android:id="@+id/tvIniciarSesion"
                    style="@style/TextoLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/action_label" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>