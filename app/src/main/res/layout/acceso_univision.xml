<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tvBrand_name"
            style="@style/TextoTitulosPantallas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/brand_name" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgLogo_image"
            android:layout_width="match_parent"
            android:layout_height="185dp"
            android:layout_marginTop="24dp"
            android:scaleType="centerCrop"
            android:src="@drawable/inicio"
            app:shapeAppearanceOverlay="@style/BannerRedondeado" />

        <TextView
            android:id="@+id/tvEncabezado"
            style="@style/TextoTitulosPantallas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/welcome_title" />

        <TextView
            android:id="@+id/tvDescripcion"
            style="@style/TextoDescriptivo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/email_label"
            android:textStyle="bold" />

        <!-- Campo Correo electrónico -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCorreo"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/fondo_app"
            app:endIconDrawable="@drawable/ic_email"
            app:endIconMode="custom"
            app:endIconTint="@color/texto_recuadro"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/email_hint"
                android:inputType="textEmailAddress"
                android:paddingVertical="14dp"
                android:textAppearance="@style/TextoCampos"
                android:textColorHint="@color/texto_recuadro" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Etiqueta Contraseña -->
        <TextView
            style="@style/TextoDescriptivo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/field_label"
            android:textStyle="bold" />

        <!-- Campo Contraseña -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilContrasena"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/fondo_app"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/texto_recuadro"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etContrasena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/field_value"
                android:inputType="textPassword"
                android:paddingVertical="14dp"
                android:textAppearance="@style/TextoCampos"
                android:textColorHint="@color/texto_recuadro" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Enlace Olvidaste tu contraseña -->
        <TextView
            android:id="@+id/tvContrasenaOlvidada"
            style="@style/TextoLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="12dp"
            android:text="@string/password_recovery" />

        <!-- Botón Iniciar sesión -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInicio"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/botones"
            android:text="@string/action_label"
            android:textAllCaps="false"
            android:textAppearance="@style/TextoBotones"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_flecha_next"
            app:iconGravity="textEnd"
            app:iconPadding="8dp"
            app:iconTint="@color/white" />

        <!-- Pie de registro -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                style="@style/TextoAdicional"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_prompt" />

            <TextView
                android:id="@+id/tvCrearCuenta"
                style="@style/TextoLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/registration_link" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>