<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/busqueda_grados"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_fondo_universidades_resultantes">

    <!--Todo dentro de un scroll-->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/explorar_grados"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/navegacion_principal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!--Cabecera-->
            <LinearLayout
                android:id="@+id/cabecera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/titulo_y_contexto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/titulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/titulo_grados"
                        android:textColor="@color/c_titulos"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/subtitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/subtitulo_grados"
                        android:textColor="@color/c_subtitulos2"
                        android:textSize="13sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/identidad"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_identidad">

                    <ImageView
                        android:id="@+id/ic_brujula"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_brujula"
                        app:tint="@color/c_iconos_etiquetas" />
                </FrameLayout>
            </LinearLayout>

            <!--Barra de búsqueda-->
            <LinearLayout
                android:id="@+id/barra_de_busqueda"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_barra_de_busqueda"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/ic_buscar"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_buscar"
                    app:tint="@color/c_subtitulos2" />

                <TextView
                    android:id="@+id/buscar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/buscar_grados"
                    android:textColor="@color/c_subtitulos2"
                    android:textSize="14sp" />

                <View
                    android:id="@+id/separador"
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:background="@color/c_fondo_buscador" />

                <ImageView
                    android:id="@+id/ic_filtros"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_filtros"
                    app:tint="@color/c_iconos_etiquetas" />
            </LinearLayout>

            <!--Filtros por categoría-->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/filtros_de_grado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/e_ingenieria"
                    style="@style/EtiquetaFiltro"
                    android:text="@string/e_ingenieria"
                    tools:ignore="MissingConstraints" />

                <TextView
                    android:id="@+id/e_salud"
                    style="@style/EtiquetaFiltro"
                    android:text="@string/e_salud"
                    tools:ignore="MissingConstraints" />

                <TextView
                    android:id="@+id/e_ciencias"
                    style="@style/EtiquetaFiltro"
                    android:text="@string/e_ciencias"
                    tools:ignore="MissingConstraints" />

                <TextView
                    android:id="@+id/e_artes"
                    style="@style/EtiquetaFiltro"
                    android:text="@string/e_artes"
                    tools:ignore="MissingConstraints" />

                <TextView
                    android:id="@+id/e_ciencias_sociales"
                    style="@style/EtiquetaFiltro"
                    android:text="@string/e_ciencias_sociales"
                    tools:ignore="MissingConstraints" />

                <androidx.constraintlayout.helper.widget.Flow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="e_ingenieria,e_salud,e_ciencias,e_artes,e_ciencias_sociales"
                    app:flow_horizontalBias="0"
                    app:flow_horizontalGap="8dp"
                    app:flow_horizontalStyle="packed"
                    app:flow_verticalGap="8dp"
                    app:flow_wrapMode="chain"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!--Encabezado de resultados-->
            <TextView
                android:id="@+id/titulo_de_resultados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/titulo_de_resultados_grados"
                android:textColor="@color/c_titulos"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!--Grado 1-->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/grado_resultante1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/c_fondo_universidades_resultantes"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/c_fondo_buscador"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <FrameLayout
                        android:id="@+id/icono_grado1"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icono_grado">

                        <ImageView
                            android:id="@+id/ic_grado1"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_codigo"
                            app:tint="@color/c_iconos_etiquetas" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/info_grado_resultante1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/nombre_grado_resultante1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/nombre_grado_resultante1"
                                android:textColor="@color/c_titulos"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/ic_flecha_siguiente1"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_flecha_siguiente"
                                app:tint="@color/c_titulos" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/universidad_grado_resultante1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/nombre_universidad_resultante1"
                            android:textColor="@color/c_subtitulos2"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:id="@+id/categoria_y_nota_grado_resultante1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/categoria_grado_resultante1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/e_ingenieria"
                                android:textColor="@color/c_subtitulos2"
                                android:textSize="11sp" />

                            <LinearLayout
                                android:id="@+id/nota_de_corte1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_nota_de_corte"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="8dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="4dp">

                                <TextView
                                    android:id="@+id/e_nota_de_corte1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/e_nota_de_corte"
                                    android:textColor="@color/c_subtitulos2"
                                    android:textSize="9sp" />

                                <TextView
                                    android:id="@+id/valor_nota_de_corte1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="@string/nota_de_corte_grado1"
                                    android:textColor="@color/c_iconos_etiquetas"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--Grado 2-->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/grado_resultante2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/c_fondo_universidades_resultantes"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/c_fondo_buscador"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <FrameLayout
                        android:id="@+id/icono_grado2"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icono_grado">

                        <ImageView
                            android:id="@+id/ic_grado2"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_cerebro"
                            app:tint="@color/c_iconos_etiquetas" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/info_grado_resultante2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/nombre_grado_resultante2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/nombre_grado_resultante2"
                                android:textColor="@color/c_titulos"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/ic_flecha_siguiente2"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_flecha_siguiente"
                                app:tint="@color/c_titulos" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/universidad_grado_resultante2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/nombre_universidad_resultante1"
                            android:textColor="@color/c_subtitulos2"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:id="@+id/categoria_y_nota_grado_resultante2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/categoria_grado_resultante2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/e_salud"
                                android:textColor="@color/c_subtitulos2"
                                android:textSize="11sp" />

                            <LinearLayout
                                android:id="@+id/nota_de_corte2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_nota_de_corte"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="8dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="4dp">

                                <TextView
                                    android:id="@+id/e_nota_de_corte2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/e_nota_de_corte"
                                    android:textColor="@color/c_subtitulos2"
                                    android:textSize="9sp" />

                                <TextView
                                    android:id="@+id/valor_nota_de_corte2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="@string/nota_de_corte_grado2"
                                    android:textColor="@color/c_iconos_etiquetas"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--Grado 3-->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/grado_resultante3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/c_fondo_universidades_resultantes"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/c_fondo_buscador"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <FrameLayout
                        android:id="@+id/icono_grado3"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icono_grado">

                        <ImageView
                            android:id="@+id/ic_grado3"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_paleta"
                            app:tint="@color/c_iconos_etiquetas" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/info_grado_resultante3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/nombre_grado_resultante3"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/nombre_grado_resultante3"
                                android:textColor="@color/c_titulos"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/ic_flecha_siguiente3"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_flecha_siguiente"
                                app:tint="@color/c_titulos" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/universidad_grado_resultante3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/nombre_universidad_resultante1"
                            android:textColor="@color/c_subtitulos2"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:id="@+id/categoria_y_nota_grado_resultante3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/categoria_grado_resultante3"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/e_artes"
                                android:textColor="@color/c_subtitulos2"
                                android:textSize="11sp" />

                            <LinearLayout
                                android:id="@+id/nota_de_corte3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_nota_de_corte"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="8dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="4dp">

                                <TextView
                                    android:id="@+id/e_nota_de_corte3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/e_nota_de_corte"
                                    android:textColor="@color/c_subtitulos2"
                                    android:textSize="9sp" />

                                <TextView
                                    android:id="@+id/valor_nota_de_corte3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="@string/nota_de_corte_grado3"
                                    android:textColor="@color/c_iconos_etiquetas"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!--Botones para navegar-->
    <LinearLayout
        android:id="@+id/navegacion_principal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/c_fondo_universidades_resultantes"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="9dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!--Botón para ir a Inicio-->
        <LinearLayout
            android:id="@+id/destino_inicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/indicador_inicio"
                android:layout_width="52dp"
                android:layout_height="28dp">

                <ImageView
                    android:id="@+id/ic_inicio"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_inicio"
                    app:tint="@color/c_subtitulos2" />
            </FrameLayout>

            <TextView
                android:id="@+id/e_inicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_inicio"
                android:textColor="@color/c_subtitulos2"
                android:textSize="10sp" />
        </LinearLayout>

        <!--Botón para ir a Universidades-->
        <LinearLayout
            android:id="@+id/destino_universidades"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/indicador_universidades"
                android:layout_width="52dp"
                android:layout_height="28dp">

                <ImageView
                    android:id="@+id/ic_universidades"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_universidades"
                    app:tint="@color/c_subtitulos2" />
            </FrameLayout>

            <TextView
                android:id="@+id/e_universidades"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_universidades"
                android:textColor="@color/c_subtitulos2"
                android:textSize="10sp" />
        </LinearLayout>

        <!--Botón para ir a Grados (donde estamos)-->
        <LinearLayout
            android:id="@+id/destino_grados"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/indicador_grados"
                android:layout_width="52dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_indicador_activo">

                <ImageView
                    android:id="@+id/ic_grados"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_grados"
                    app:tint="@color/c_iconos_etiquetas" />
            </FrameLayout>

            <TextView
                android:id="@+id/e_grados"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_grados"
                android:textColor="@color/c_iconos_etiquetas"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!--Botón para ir a Perfil-->
        <LinearLayout
            android:id="@+id/destino_perfil"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/indicador_perfil"
                android:layout_width="52dp"
                android:layout_height="28dp">

                <ImageView
                    android:id="@+id/ic_perfil"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_perfil"
                    app:tint="@color/c_subtitulos2" />
            </FrameLayout>

            <TextView
                android:id="@+id/e_perfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/texto"
                android:textColor="@color/c_subtitulos2"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>