<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detalle_universidad"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_fondo_universidades_resultantes">

    <!-- ===================== CONTENIDO (con scroll) ===================== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/contenido_detalle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/barra_de_acciones"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============ Campus ============ -->
            <FrameLayout
                android:id="@+id/campus"
                android:layout_width="match_parent"
                android:layout_height="220dp">

                <ImageView
                    android:id="@+id/fotografia_del_campus"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/universidad_complutense_de_madrid"
                    tools:background="@color/c_fondo_busqueda" />

                <FrameLayout
                    android:id="@+id/accion_volver"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_favorito"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ic_flecha_atras"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/volver"
                        android:src="@drawable/ic_flecha_atras"
                        app:tint="@color/c_titulos" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/accion_de_favorito"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_favorito"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ic_favorito"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/guardar_universidad"
                        android:src="@drawable/ic_favorito"
                        app:tint="@color/c_favorito_seleccionado" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/zona_del_campus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_tipo"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp">

                    <ImageView
                        android:id="@+id/ic_ubicacion_campus"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ubicacion"
                        app:tint="@color/c_iconos_etiquetas" />

                    <TextView
                        android:id="@+id/e_campus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/e_campus"
                        android:textColor="@color/c_titulos"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- ============ Información general ============ -->
            <LinearLayout
                android:id="@+id/informacion_general"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/nombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nombre_universidad_resultante1"
                    android:textColor="@color/c_titulos"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Ubicación y tipo -->
                <LinearLayout
                    android:id="@+id/ubicacion_y_tipo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ic_ubicacion"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ubicacion"
                        app:tint="@color/c_subtitulos2" />

                    <TextView
                        android:id="@+id/ciudad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/e_ubicacion1"
                        android:textColor="@color/c_subtitulos2"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/separador_ubicacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/separador_punto"
                        android:textColor="@color/c_subtitulos2"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tipo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/tipo_universidad_publica"
                        android:textColor="@color/c_iconos_etiquetas"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Estadísticas -->
                <LinearLayout
                    android:id="@+id/estadisticas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/estadistica_grados"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_estadistica"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ic_grados"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_grados"
                                app:tint="@color/c_iconos_etiquetas" />

                            <TextView
                                android:id="@+id/dato_grados"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/dato_grados"
                                android:textColor="@color/c_titulos"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/etiqueta_grados"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/etiqueta_grados"
                            android:textColor="@color/c_subtitulos2"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/estadistica_valoracion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_estadistica"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ic_estrella"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_estrella"
                                app:tint="@color/c_iconos_etiquetas" />

                            <TextView
                                android:id="@+id/dato_valoracion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/puntuacion_universidad_resultante1"
                                android:textColor="@color/c_titulos"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/etiqueta_valoracion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/etiqueta_valoracion"
                            android:textColor="@color/c_subtitulos2"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/estadistica_facultades"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_estadistica"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ic_universidades"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_universidades"
                                app:tint="@color/c_iconos_etiquetas" />

                            <TextView
                                android:id="@+id/dato_facultades"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/dato_facultades"
                                android:textColor="@color/c_titulos"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/etiqueta_facultades"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/etiqueta_facultades"
                            android:textColor="@color/c_subtitulos2"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Descripción -->
                <TextView
                    android:id="@+id/titulo_descripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/titulo_descripcion"
                    android:textColor="@color/c_titulos"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/descripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/descripcion_universidad"
                    android:textColor="@color/c_subtitulos"
                    android:textSize="13sp" />

                <!-- Opiniones -->
                <TextView
                    android:id="@+id/titulo_opiniones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/titulo_opiniones"
                    android:textColor="@color/c_titulos"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Opinión 1 -->
                <LinearLayout
                    android:id="@+id/opinion1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/avatar1"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_avatar"
                        android:gravity="center"
                        android:text="@string/opinion1_iniciales"
                        android:textColor="@color/c_iconos_etiquetas"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/autor1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/opinion1_autor"
                                android:textColor="@color/c_titulos"
                                android:textSize="12sp" />

                            <LinearLayout
                                android:id="@+id/estrellas1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_estrella"
                                    app:tint="@color/c_estrella" />

                                <ImageView
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:layout_marginStart="1dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_estrella"
                                    app:tint="@color/c_estrella" />

                                <ImageView
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:layout_marginStart="1dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_estrella"
                                    app:tint="@color/c_estrella" />

                                <ImageView
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:layout_marginStart="1dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_estrella"
                                    app:tint="@color/c_estrella" />

                                <ImageView
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:layout_marginStart="1dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_estrella"
                                    app:tint="@color/c_estrella" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/texto1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/opinion1_texto"
                            android:textColor="@color/c_subtitulos2"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Opinión 2 -->
                <LinearLayout
                    android:id="@+id/opinion2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/avatar2"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_avatar"
                        android:gravity="center"
                        android:text="@string/opinion2_iniciales"
                        android:textColor="@color/c_iconos_etiquetas"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/autor2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/opinion2_autor"
                                android:textColor="@color/c_titulos"
                                android:textSize="12sp" />

                            <LinearLayout
                                android:id="@+id/estrellas2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_estrella"
                                    app:tint="@color/c_estrella" />

                                <ImageView
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:layout_marginStart="1dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_estrella"
                                    app:tint="@color/c_estrella" />

                                <ImageView
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:layout_marginStart="1dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_estrella"
                                    app:tint="@color/c_estrella" />

                                <ImageView
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:layout_marginStart="1dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_estrella"
                                    app:tint="@color/c_estrella" />

                                <ImageView
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:layout_marginStart="1dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_estrella"
                                    app:tint="@color/c_fondo_buscador" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/texto2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/opinion2_texto"
                            android:textColor="@color/c_subtitulos2"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===================== BARRA DE ACCIONES ===================== -->
    <LinearLayout
        android:id="@+id/barra_de_acciones"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/c_fondo_universidades_resultantes"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/boton_web_oficial"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_boton_secundario"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/e_web_oficial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/boton_web_oficial"
                android:textColor="@color/c_iconos_etiquetas"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ic_enlace_externo"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_enlace_externo"
                app:tint="@color/c_iconos_etiquetas" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/boton_ver_grados"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_boton_primario"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/e_ver_grados"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/boton_ver_grados"
                android:textColor="@color/c_fondo_universidades_resultantes"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ic_flecha_derecha"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_flecha_derecha"
                app:tint="@color/c_fondo_universidades_resultantes" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>